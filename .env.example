# AWS
AWS_REGION=us-east-1
AWS_PROFILE=default

# Base de conhecimento (Parte 2 / tool retrieve_kb)
# O bucket precisa JA existir na conta AWS (criado manualmente); o template SAM
# so le dele. Passe este mesmo valor no deploy:
#   sam deploy --parameter-overrides KnowledgeBaseBucketName=$S3_BUCKET_NAME
S3_BUCKET_NAME=concierge-conectatel-kb-squad4
CORPUS_PREFIX=knowledge-base/
VECTOR_STORE_PATH=artifacts/index
EMBEDDINGS_KEY=index/embeddings.json
CHUNKS_KEY=processed/chunks.json

# Recuperação (valor fixado a partir do calibration_report.json)
RETRIEVAL_SCORE_THRESHOLD=0.85
RETRIEVAL_TOP_K=3

# Agente (Parte 3). Nova nao exige formulario de caso de uso e roda on-demand.
# Para usar Claude (us.anthropic.claude-haiku-4-5-20251001-v1:0) e preciso antes
# preencher o "Anthropic use case details" no console Bedrock > Model access.
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0

# Lambdas que o agente invoca como tools
RETRIEVE_KB_FUNCTION=concierge-conectatel-retrieve-kb
STORE_HANDOFF_FUNCTION=concierge-conectatel-store-handoff

# Endpoint publicado pelo API Gateway (POST /concierge). Preencha somente no
# .env local: uma URL de conta individual não deve ir para o repositório.
CONCIERGE_API_URL=

# Escalonamento (Parte 4) — tool store_handoff
HANDOFF_TABLE_NAME=concierge-conectatel-escalonamentos

# Governança (Parte 5) — auditoria via CloudWatch Logs Insights
AUDIT_LOG_GROUP=/concierge/agent
