{
  "name": "conectatel-medallion-pipeline",
  "format": "MULTI_TASK",
  "max_concurrent_runs": 1,
  "timeout_seconds": 3600,
  "parameters": [
    {"name": "workspace_path", "default": "/Workspace/Users/<usuario>/concierge-conectatel"},
    {"name": "compute_id", "default": "<compute-id>"}
  ],
  "tasks": [
    {
      "task_key": "bronze",
      "notebook_task": {"notebook_path": "{{job.parameters.workspace_path}}/src/parte_01_dados/01_bronze_ingestao"},
      "existing_cluster_id": "{{job.parameters.compute_id}}"
    },
    {
      "task_key": "silver",
      "depends_on": [{"task_key": "bronze"}],
      "notebook_task": {"notebook_path": "{{job.parameters.workspace_path}}/src/parte_01_dados/02_silver_limpeza"},
      "existing_cluster_id": "{{job.parameters.compute_id}}"
    },
    {
      "task_key": "gold",
      "depends_on": [{"task_key": "silver"}],
      "notebook_task": {"notebook_path": "{{job.parameters.workspace_path}}/src/parte_01_dados/03_gold_analise"},
      "existing_cluster_id": "{{job.parameters.compute_id}}"
    }
  ]
}
